    "dialogueIndex": 71,
    "rawLine": 220,
    "type": "dialogue",
    "speaker": "JAMIE",
    "voice": "F1",
    "text": "AI as collaborator.",
    "chapter": "SEGMENT 11: FUTURE-PROOFING YOUR SKILLS (3 minutes)",
    "file": "0071.mp3",
    "duration": 1.881,
    "startTime": 436.001
  },
