    "rawLine": 216,
    "type": "dialogue",
    "speaker": "JAMIE",
    "voice": "F1",
    "text": "Where do you see this going? How should we think about the future?",
    "chapter": "SEGMENT 11: FUTURE-PROOFING YOUR SKILLS (3 minutes)",
    "file": "0069.mp3",
    "duration": 4.389,
    "startTime": 422.417
  },
  {
