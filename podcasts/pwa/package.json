{
  "name": "podlearn-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build-episodes.js",
    "audio:list": "SUPERTONIC_DIR=${SUPERTONIC_DIR:-$HOME/code/supertonic} node ../tools/generate-audio-supertonic.js --list",
    "audio:episode": "SUPERTONIC_DIR=${SUPERTONIC_DIR:-$HOME/code/supertonic} node ../tools/generate-audio-supertonic.js",
    "audio:show": "SUPERTONIC_DIR=${SUPERTONIC_DIR:-$HOME/code/supertonic} node ../tools/generate-audio-supertonic.js --all",
    "audio:shows": "SUPERTONIC_DIR=${SUPERTONIC_DIR:-$HOME/code/supertonic} node ../tools/generate-audio-supertonic-parallel.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0"
  }
}
