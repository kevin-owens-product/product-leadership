    "dialogueIndex": 70,
    "rawLine": 218,
    "type": "dialogue",
    "speaker": "ALEX",
    "voice": "M1",
    "text": "AI assistance in development is only going to grow. The developers who thrive will be those who learn to collaborate effectively with AI.",
    "chapter": "SEGMENT 11: FUTURE-PROOFING YOUR SKILLS (3 minutes)",
    "file": "0070.mp3",
    "duration": 9.195,
    "startTime": 426.806
  },
