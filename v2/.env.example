# =============================================================================
# Podcast AI V2 — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# ---- Supabase ----
# Found in your Supabase project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ---- Anthropic (Claude API) ----
# Used for show planning, script generation, and content moderation.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- OpenAI ----
# Used for text-to-speech audio generation (tts-1 and tts-1-hd models).
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=sk-...

# ---- RevenueCat (In-App Purchases) ----
# Optional — only needed for credit purchases via App Store / Play Store.
# Get keys at https://app.revenuecat.com/
REVENUECAT_API_KEY_IOS=appl_...
REVENUECAT_API_KEY_ANDROID=goog_...

# ---- Expo / EAS ----
# Your EAS project ID from https://expo.dev/
EAS_PROJECT_ID=your-eas-project-id

# =============================================================================
# Where to set these:
#
# MOBILE APP (app.json > expo.extra):
#   supabaseUrl, supabaseAnonKey, revenueCatApiKeyIos, revenueCatApiKeyAndroid
#
# SUPABASE EDGE FUNCTIONS (supabase secrets set):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY
#
# EAS BUILD (eas.json or expo.dev):
#   EAS_PROJECT_ID
# =============================================================================
